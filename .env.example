# Pointless frontend — build/runtime env vars.
# Only VITE_-prefixed vars are exposed to the client bundle.

# Backend
VITE_API_BASE_URL=http://localhost:5003/api/v1

# Firebase (Phase B — web config, not secret per Firebase docs)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Pusher (Phase E)
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=us2
